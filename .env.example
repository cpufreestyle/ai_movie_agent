# 复制为 .env 后按需修改（docker compose 自动读取）
# —— LLM（Ollama）——
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=ollama            # Ollama 默认 ollama，一般不用改

# —— 视频生成（ComfyUI，需 NVIDIA 显卡）——
# 同 compose 内启用 comfyui 服务时保持默认；
# 否则改成远程有显卡机器的地址，例如：
# COMFYUI_API=http://192.168.1.20:8188
COMFYUI_API=http://comfyui:8188

# —— 默认视频引擎 ——
# comfyui_mmH3 = MiniMax H3（默认）  /  comfyui_ltx = LTX-2.5
ENGINE_BACKEND=comfyui_mmH3

# —— 显卡后端：nvidia（默认） / amd（ROCm）——
# amd 时 NVFP4 不支持，Agent 会自动把 LTX 精度降为 bf16（视频权重须用 bf16/INT8 变体）
GPU_BACKEND=nvidia

# —— ComfyUI 镜像（仅 docker compose --profile gpu 启用视频服务时需要）——
# NVIDIA：换成你们「含 LTX-2.5 / MiniMax H3 节点」的 ComfyUI 镜像；留空则用占位名（需替换）
COMFYUI_IMAGE=your-registry/comfyui-ltx-mmh3:latest
# AMD/ROCm：仅在用 docker-compose.amd.yml 覆盖时需要，填 ROCm 版 ComfyUI 镜像
COMFYUI_IMAGE_ROCM=your-registry/comfyui-rocm:latest
