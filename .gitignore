# 本地配置：含 api_key，且 WebUI 的「接口与模型设置」会写回该文件。
# 本仓库为公开仓库 —— 一旦提交即等于公开泄露密钥。仓库只保留 config.example.yaml。
config.yaml
config.local.yaml

# 虚拟环境
.venv/
.venv-win/
env/
venv/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 生成的产物（渲染视频、state.json 等运行时输出）
outputs/
outputs-windows-test/
output/

# 系统文件
Thumbs.db
.DS_Store

# 本地日志
*.log
.github_ssh_known_hosts

# 第三方发布工具（运行时通过 tools/_install_biliup.py 安装，不入库）
tools/biliup/

# Blender 便携版（运行时下载解压，体积大不入库；用 tools/_install_blender.py 安装）
tools/blender/

# runtime logs / artifacts / backups (not tracked)
*.err
*.bak
diag_*.png
comfy_run.log

# 创空间部署时的临时克隆（内含嵌套 .git，不能进索引）
space/_deploy_tmp/

# one-off dev scripts (underscore prefix)
_*.py
_*.ps1
_*.bat
kill_test.py
tmp_vae_test.py

# 测试 / 构建缓存
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# 本地测试 / 截图临时目录（agent-browser 自测产物）
.workbuddy/tmp/
