project:
  title: 《看见未来之前》
  theme: 一部发生在近未来赛博都市的科幻短片，探讨记忆与身份第三集
  style: cinematic, film grain, 35mm, dramatic lighting, slow camera movement
  episode_seconds: 60
  scene_frames: 97
engine:
  skyreels_repo: ./skyreels_v2
  model_id: Skywork/SkyReels-V2-DF-1.3B-540P
  resolution: 540P
  offload: true
  fps: 24
  ar_step: 0
  overlap_history: 17
  addnoise_condition: 20
  base_num_frames: 97
  guidance_scale: 6
  inference_steps: 30
  two_pass_i2v: true
  python: ''
  backend: skyreels
  comfyui_ltx:
    api: http://127.0.0.1:8188
    workflow: workflows/ltx2_5_t2v_api.json
    precision: fp4
    checkpoint: ltx-2.5-22b-distilled-transformer-nvfp4.safetensors
    text_encoder: gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors
    unet_gguf: LTX-2.5-Distilled-Q2_K.gguf
    video_vae: ltx-2.5-video-vae-bf16.safetensors
    audio_vae: ltx-2.5-audio-vae-bf16.safetensors
    resolution: 512x288
    fps: 24
    num_frames: 121
    seed: 0
    negative: ''
    nodes:
      prompt: '5508'
      negative: '5509'
      fps: '5511'
      duration: '5512'
      seed: '5516_4832'
      latent: '5514_3059'
      unet: '5004_5569'
      clip_12b: '5004_5572'
      clip_2b: '5004_5545'
      audio_vae: '5004_5570'
      video_vae: '5004_5571'
      load_image: '2004'
      i2v_enable: '5014_5506'
      prompt_switch: '5014_5556'
llm:
  base_url: http://localhost:11434/v1
  api_key: ollama
  model: qwen2.5:3b
  temperature: 0.85
  disabled: false
profiles:
  llm:
    ollama_lfm:
      base_url: http://127.0.0.1:11434/v1
      api_key: ollama
      model: qwen2.5:3b
      temperature: 0.85
      disabled: false
    template:
      disabled: true
  comfyui:
    minimax_h3:
      api: http://127.0.0.1:8188
      workflow: ''
    ltx25:
      api: http://127.0.0.1:8188
      workflow: ''
  engine:
    skyreels_wsl:
      skyreels_repo: ./skyreels_v2
      model_id: Skywork/SkyReels-V2-DF-1.3B-540P
      resolution: 540P
      offload: true
      fps: 24
      scene_frames: 97
    comfyui_ltx:
      backend: comfyui_ltx
      api: http://127.0.0.1:8188
      workflow: workflows/ltx2_5_t2v_api.json
      precision: fp4
      checkpoint: ltx-2.5-22b-distilled-transformer-nvfp4.safetensors
      text_encoder: gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors
      unet_gguf: LTX-2.5-Distilled-Q2_K.gguf
      video_vae: ltx-2.5-video-vae-bf16.safetensors
      audio_vae: ltx-2.5-audio-vae-bf16.safetensors
      resolution: 512x288
      fps: 24
      num_frames: 121
      seed: 0
  collector:
    local_requests:
      enabled: true
      method: requests
  knowledge:
    local:
      enabled: true
      backend: local
  publish:
    disabled:
      enabled: false
stage_profiles:
  A:
    collector: local_requests
  B:
    knowledge: local
  C:
    llm: ollama_lfm
  D:
    llm: ollama_lfm
    comfyui: minimax_h3
  E:
    llm: ollama_lfm
  F:
    llm: ollama_lfm
  G:
    llm: ollama_lfm
    engine: skyreels_wsl
  H:
    publish: disabled
collector:
  enabled: true
  method: requests
  urls:
  - https://en.wikipedia.org/wiki/Cyberpunk
  - https://zh.wikipedia.org/wiki/赛博朋克
  - https://en.wikipedia.org/wiki/Memory
  - https://en.wikipedia.org/wiki/Personal_identity
  save_dir: material
knowledge:
  enabled: true
  backend: ragflow
  local_dir: kb
  ragflow:
    api: http://localhost:80/api
    dataset: ai_movie
    api_key: ''
planner:
  enabled: true
  roles:
  - 编剧
  - 导演
  - 制片人
image_prompt:
  enabled: true
  comfyui:
    api: http://127.0.0.1:8188
    workflow: ''
polisher:
  enabled: true
  method: llm
output:
  dir: ./outputs
publish:
  enabled: false
  binary: tools/biliup/biliupR-v0.2.4-x86_64-windows/biliup.exe
  account: ''
  title_template: '{title} · 第{n}集'
  desc_template: '片名《看见未来之前》——一部由本地 AI 电影 Agent 自动企划、生成的概念短片 demo。


    这个 Agent 能做什么：

    · 持续创作 / 无限时长：基于 SkyReels-V2 的 Diffusion Forcing 续写，影片可一直生长；

    · 全链路自动化：素材采集 → 知识沉淀 → 概念企划 → 关键帧 → 剧本 → 去 AI 味润色 → 视频导演 → 自动投稿 B 站；

    · 本地 LLM 自动写剧本（无模型也能跑通模板兜底）。


    用 AI 提前看见未来——让 Agent 把一句话创意变成可投稿的影像。

    #魔搭社区 #Qoder #AI无限开发者创作大赛 #用AI提前看见未来 #AIGC

    '
  tags: AI影视,人工智能,短片,AIGC,打赏,AI电影,开源项目
  tid: 171
  source: ''
  dynamic: AI 自动生成的实验短片
  cover: ''
  dtime: 0
blender:
  enabled: true
  host: 127.0.0.1
  port: 9876
  width: 1280
  height: 720
  anim_frames: 24
  use_as_i2v_start: false
  use_llm_parse: false
